{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": false,
    "target": "ES2022",
    "module": "preserve",
    "baseUrl": "./",
    "paths": {
      "@core/*": [
        "src/app/core/*"
      ],
      "@pages/*": [
        "src/app/pages/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ],
      "@environments/*": [
        "src/environments/*"
      ],
      "@spartan-ng/helm/input-group": [
        "./libs/ui/input-group/src/index.ts"
      ],
      "@spartan-ng/helm/utils": [
        "./libs/ui/utils/src/index.ts"
      ],
      "@spartan-ng/helm/button": [
        "./libs/ui/button/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "./libs/ui/input/src/index.ts"
      ],
      "@spartan-ng/helm/textarea": [
        "./libs/ui/textarea/src/index.ts"
      ],
      "@spartan-ng/helm/icon": [
        "./libs/ui/icon/src/index.ts"
      ],
      "@spartan-ng/helm/label": [
        "./libs/ui/label/src/index.ts"
      ],
      "@spartan-ng/helm/separator": [
        "./libs/ui/separator/src/index.ts"
      ],
      "@spartan-ng/helm/date-picker": [
        "./libs/ui/date-picker/src/index.ts"
      ],
      "@spartan-ng/helm/calendar": [
        "./libs/ui/calendar/src/index.ts"
      ],
      "@spartan-ng/helm/select": [
        "./libs/ui/select/src/index.ts"
      ],
      "@spartan-ng/helm/popover": [
        "./libs/ui/popover/src/index.ts"
      ],
      "@spartan-ng/helm/combobox": [
        "./libs/ui/combobox/src/index.ts"
      ],
      "@spartan-ng/helm/toggle": [
        "./libs/ui/toggle/src/index.ts"
      ],
      "@spartan-ng/helm/toggle-group": [
        "./libs/ui/toggle-group/src/index.ts"
      ],
      "@spartan-ng/helm/tabs": [
        "./libs/ui/tabs/src/index.ts"
      ],
      "@spartan-ng/helm/sonner": [
        "./libs/ui/sonner/src/index.ts"
      ],
      "@spartan-ng/helm/alert-dialog": [
        "./libs/ui/alert-dialog/src/index.ts"
      ],
      "@spartan-ng/helm/dialog": [
        "./libs/ui/dialog/src/index.ts"
      ],
      "@spartan-ng/helm/skeleton": [
        "./libs/ui/skeleton/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
